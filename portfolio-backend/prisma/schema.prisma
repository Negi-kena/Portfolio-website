generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  @@map("users")
}

model Tag {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  slug     String     @unique
  projects ProjectTag[]
  posts    BlogPostTag[]

  @@map("tags")
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  summary     String                     // short one-liner for cards
  description String   @db.Text          // full case-study body (markdown)
  imageUrl    String?
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)       // manual display ordering
  tags        ProjectTag[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@map("projects")
}

model ProjectTag {
  projectId Int
  tagId     Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text          // markdown body
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  tags        BlogPostTag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("blog_posts")
}

model BlogPostTag {
  blogPostId Int
  tagId      Int
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@map("blog_post_tags")
}

model Message {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  subject    String?
  message    String    @db.Text
  read       Boolean   @default(false)
  replied    Boolean   @default(false)
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([read])
  @@map("messages")
}

// Singleton row (id is always 1) holding editable site-wide content
model SiteSettings {
  id           Int      @id @default(1)
  heroTitle    String
  heroSubtitle String
  bio          String   @db.Text
  avatarUrl    String?
  resumeUrl    String?
  email        String?
  github       String?
  linkedin     String?
  twitter      String?
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
